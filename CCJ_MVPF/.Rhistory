# R: add a short variable name per ROW (based on Subcomponent values)
library(readxl)
library(dplyr)
library(writexl)
in_path  <- "/mnt/data/CCJ_quantified_values.xlsx"
out_path <- "/mnt/data/CCJ_quantified_values_with_rowvars.xlsx"
df <- read_excel(in_path, sheet = 1)
library(readr)
mvpf_inputs <- readxl::read_excel("/Users/larapesceares/CCJ/Data/CCJ_quantified_values.xlsx")
# Make a new data frame with short row names based on the Subcomponent column
library(dplyr)
library(stringr)
# you already have:
# mvpf_inputs <- readxl::read_excel("/Users/larapesceares/CCJ/Data/CCJ_quantified_values.xlsx")
# 1) normalize the key text (trim/squish)
df_norm <- mvpf_inputs %>%
mutate(Sub_clean = str_squish(as.character(`Subcomponent`)))
# Make a new data frame with short row names based on the Subcomponent column
library(dplyr)
library(stringr)
# you already have:
# mvpf_inputs <- readxl::read_excel("/Users/larapesceares/CCJ/Data/CCJ_quantified_values.xlsx")
# 1) normalize the key text (trim/squish)
df_norm <- mvpf_inputs %>%
mutate(Sub_clean = str_squish(as.character(`subcomponent`)))
# 2) map Subcomponent -> short row names
df_named <- df_norm %>%
mutate(
row_var = dplyr::recode(
Sub_clean,
"Value of future criminality prevented" = "crime_prev_value",
"Wrongful death damages Social cost of detainment and wtp for a human life" = "wrongful_death_wtp_life",
"Cost of crime - HAVEN framework" = "haven_cost_of_crime",
"Measure of crime prevented as a result of the detention" = "crime_prev_measure",
"Sentencing, conviction, and plea rates per released defendants" = "case_outcomes_released",
"Reduced income" = "income_reduced",
"Length of Stay (LoS)" = "los_days",
"Employment rate" = "emp_rate",
"Wage" = "wage",
"Employment level" = "emp_level",
"Lost wages" = "lost_wages",
"WTP for Freedom" = "wtp_freedom",
"WTP Relative harm valuation" = "wtp_rhv",
"Increased Probability of Conviction and Longer Sentences" = "inc_conv_len",
"Marginal Cost Jail Days" = "mc_jail_day",
"Spike in Public Health Spending post-release" = "postrel_health_spike",
"Total Funding for CCJ (2018)" = "ccj_funding_2018",
"n Detainees" = "n_detainees",
"n Society" = "n_society",
.default = NA_character_
)
) %>%
select(row_var, everything(), -Sub_clean)  # put the new name first
# 3) (optional) actually set row names; tibbles don't love rownames, so only do this if you need them
# rownames_df <- as.data.frame(df_named)
# rownames(rownames_df) <- rownames_df$row_var
# Resulting data frame with the new row names column:
mvpf_inputs_named <- df_named
# Quick peek
dplyr::count(mvpf_inputs_named, row_var, sort = TRUE)
View(mvpf_inputs)
View(mvpf_inputs_named)
View(mvpf_inputs)
View(mvpf_inputs_named)
# overwrite the original file with the updated data frame
library(writexl)
path <- "/Users/larapesceares/CCJ/Data/CCJ_quantified_values.xlsx"
# (optional) make a quick backup first:
# write_xlsx(mvpf_inputs_named, sub("\\.xlsx$", "_backup.xlsx", path))
write_xlsx(mvpf_inputs_named, path)
message("Overwrote: ", normalizePath(path))
