library(readxl)
library(dplyr)
library(writexl)
path <- "/Users/larapesceares/CCJ/Data/CCJ_quantified_values.xlsx"
# read (first sheet)
mvpf_inputs <- read_excel(path, sheet = 1)
# rename exactly the columns you listed -> short snake_case
mvpf_inputs <- mvpf_inputs %>%
rename(
row_var            = `row_var`,
comp_name          = `component name`,
subcomp            = `subcomponent`,
alt                = `alternative`,
unit               = `unit`,
timeframe          = `timeframe`,
deps               = `dependencies`,
selected_value     = `selected value`,
min                = `min`,
mean               = `mean`,
median             = `median`,
max                = `max`,
source_dollar_year = `source dollar year`,
impact             = `impact`,
notes              = `notes`,
source1            = `source 1`,
link1              = `link 1`,
source2            = `source 2`,
link2              = `link 2`
)
# optional: quick sanity check
stopifnot(all(c(
"row_var","comp_name","subcomp","alt","unit","timeframe","deps","selected_value",
"min","mean","median","max","source_dollar_year","impact","notes","source1","link1","source2","link2"
) %in% names(mvpf_inputs)))
# overwrite original file (uncomment backup if you want one)
# write_xlsx(mvpf_inputs, sub("\\.xlsx$", "_backup.xlsx", path))
write_xlsx(mvpf_inputs, path)
message("Overwrote: ", normalizePath(path))
